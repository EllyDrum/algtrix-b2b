# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em
# Netlify > Site configuration > Environment variables (escopo: Functions e Builds).
# NUNCA coloque estes valores no código-fonte ou com prefixo NEXT_PUBLIC_.

# URL pública do site (SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://algtrix-b2b.netlify.app

# Pagamento: "mercadopago" em produção. "mock" simula a aprovação e só funciona fora da produção.
PAYMENT_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Segredos internos (gere textos aleatórios com 32+ caracteres)
ORDER_TOKEN_SECRET=
INTERNAL_SECRET=

# Cloudflare R2 (bucket privado com a base em Parquet e os arquivos dos pedidos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=algtrix-base
R2_BASE_PREFIX=base/2026-09

# E-mail transacional (Resend). Sem estas variáveis, o cliente baixa pela página do pedido.
RESEND_API_KEY=
EMAIL_REMETENTE=Algtrix B2B <pedidos@seudominio.com.br>

# Opcionais
LEAD_WEBHOOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Copie este arquivo para .env.local e preencha com valores reais antes de ir para produção.
# NUNCA coloque estes valores diretamente no código-fonte ou no frontend.

# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://b2b.algtrix.com.br

# Provedor de pagamento (definir quando o provedor for escolhido: mercadopago | stripe | hotmart)
PAYMENT_PROVIDER=

# Credenciais do provedor de pagamento (server-side apenas — nunca prefixar com NEXT_PUBLIC_)
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=

# Integração de captura de lead (ex.: webhook de CRM, planilha, e-mail transacional)
LEAD_WEBHOOK_URL=

# WhatsApp comercial para recuperação de intenção e suporte (formato E.164, ex.: 5511999999999)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics (GA4 / GTM) — opcional
NEXT_PUBLIC_GA_MEASUREMENT_ID=

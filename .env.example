# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes em
# Netlify > Site configuration > Environment variables (escopo: Functions e Builds).
# NUNCA coloque estes valores no código-fonte ou com prefixo NEXT_PUBLIC_.

# URL pública do site (SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://algtrix-b2b.netlify.app

# Pagamento. Duas formas, que podem coexistir:
# 1) Pix direto na chave da empresa (QR Code gerado pelo site; confirmação manual em /admin/pedidos)
PIX_CHAVE=48653532000154
PIX_NOME=ALGTRIX CONSULTORIA LTDA
PIX_CIDADE=SAO PAULO
# 2) Stripe (cartão de crédito parcelado; webhook em /api/webhook/stripe, evento checkout.session.completed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 3) Mercado Pago (Pix com confirmação automática + cartão). Quando preenchido, tem prioridade no Pix; no cartão a Stripe prevalece.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# "mock" simula a aprovação e só funciona fora da produção.
PAYMENT_PROVIDER=

# Segredos internos (gere textos aleatórios com 32+ caracteres)
ORDER_TOKEN_SECRET=
INTERNAL_SECRET=

# Cloudflare R2 (bucket privado com a base em Parquet e os arquivos dos pedidos)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=algtrix-base
R2_BASE_PREFIX=base/2026-09

# E-mail transacional (Resend). Sem estas variáveis, o cliente baixa pela página do pedido.
RESEND_API_KEY=
EMAIL_REMETENTE=Algtrix B2B <pedidos@seudominio.com.br>

# Opcionais
LEAD_WEBHOOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
